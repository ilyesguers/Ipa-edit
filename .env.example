# ============================================
# DIGITAL KEYS STORE — Environment Variables
# ============================================
# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# MongoDB (Railway provides this automatically)
MONGODB_URI=mongodb://localhost:27017/digital_keys_store

# Premium animated game emoji (Telegram Premium is required to SEND them).
# The bot uses one centralized gamepad/trophy/skull/loot/shield set.
# true  = premium icons on buttons and HTML messages (default).
# false = safe unicode fallback everywhere.
# If Telegram rejects an ID or an unsupported button style, the request is
# retried without premium fields so the keyboard never disappears.
USE_PREMIUM_EMOJI=true
# Optional overrides if the bot owner uses a different accessible emoji pack:
PREMIUM_EMOJI_GAMEPAD=5285430309720966085
PREMIUM_EMOJI_TROPHY=5310076249404621168
PREMIUM_EMOJI_SKULL=5310169226856644648
PREMIUM_EMOJI_LOOT=5388790256772331442
PREMIUM_EMOJI_SHIELD=5368324170671202286
PREMIUM_EMOJI_SETTINGS=5285032475490273112

# Server
PORT=3000
BASE_URL=https://your-railway-app.up.railway.app
JWT_SECRET=your_super_secret_jwt_key_change_this

# Binance Pay (optional - can be set via Admin Panel)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MERCHANT_ID=
USDT_WALLET_TRC20=

# Webhook (for production on Railway)
WEBHOOK_DOMAIN=https://your-railway-app.up.railway.app
