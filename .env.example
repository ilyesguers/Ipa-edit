# ============================================
# DIGITAL KEYS STORE — Environment Variables
# ============================================
# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# MongoDB (Railway provides this automatically)
MONGODB_URI=mongodb://localhost:27017/digital_keys_store

# Premium animated custom emoji (Telegram Premium required to SEND them).
# true  = use premium animated emoji on buttons and in messages (default).
# false = fall back to plain unicode emoji everywhere.
# NOTE: even when true, the bot auto-retries without premium emoji if Telegram
# rejects an invalid emoji id, so it will never break your messages.
USE_PREMIUM_EMOJI=true

# Server
PORT=3000
BASE_URL=https://your-railway-app.up.railway.app
JWT_SECRET=your_super_secret_jwt_key_change_this

# Binance Pay (optional - can be set via Admin Panel)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MERCHANT_ID=
USDT_WALLET_TRC20=

# Webhook (for production on Railway)
WEBHOOK_DOMAIN=https://your-railway-app.up.railway.app
