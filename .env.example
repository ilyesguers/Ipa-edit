# ============================================
# 🔥 GAMER STORE - Environment Variables
# ============================================
# Telegram Bot - Get from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Optional - shown in bot messages (support & channel buttons)
SUPPORT_USERNAME=support
CHANNEL_USERNAME=your_channel

# MongoDB - Railway provides automatically or use Atlas
MONGODB_URI=mongodb://localhost:27017/gamer_store_legends

# ============================================
# 🎮 PREMIUM GAMING EMOJIS - 16 unique IDs for teens
# Each emoji has its own ID - no more 4 repeated!
# ============================================
# Keep this off unless you have configured valid IDs from your own emoji pack.
# Unicode icons are faster and avoid duplicated/invalid custom emoji.
USE_PREMIUM_EMOJI=false

# Core gaming pack - get distinct IDs from @emoji or your own pack
PREMIUM_EMOJI_GAMEPAD=5285430309720966085
PREMIUM_EMOJI_JOYSTICK=5347680802671880999
PREMIUM_EMOJI_TROPHY=5310076249404621168
PREMIUM_EMOJI_CROWN=5325567351006222032
PREMIUM_EMOJI_FIRE=5351394124793794923
PREMIUM_EMOJI_ROCKET=5377593766659329633
PREMIUM_EMOJI_LIGHTNING=5304376509377252997
PREMIUM_EMOJI_TARGET=5355066655298458910
PREMIUM_EMOJI_EXPLOSION=5384150787003857204
PREMIUM_EMOJI_GEM=5314859470430858628
PREMIUM_EMOJI_DIAMOND=5388790256772331442
PREMIUM_EMOJI_SKULL=5310169226856644648
PREMIUM_EMOJI_GHOST=5399843699312044143
PREMIUM_EMOJI_ALIEN=5404766660500196029
PREMIUM_EMOJI_SHIELD=5368324170671202286
PREMIUM_EMOJI_WALLET=5361809848994090204
PREMIUM_EMOJI_SPARKLE=5372984826433338537
PREMIUM_EMOJI_COIN=5361809848994090205
PREMIUM_EMOJI_STAR=5368723352220948628
PREMIUM_EMOJI_BOLT=5304376509377252998

# Legacy aliases (keep for backward compat)
PREMIUM_EMOJI_LOOT=5388790256772331442
PREMIUM_EMOJI_SETTINGS=5285032475490273112

# Server - Railway sets PORT automatically
PORT=3000
BASE_URL=https://your-railway-app.up.railway.app
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_32_chars

# Binance Pay (optional - set via Admin Panel too)
# BINANCE_MERCHANT_ID is used as your "Binance ID" / Pay ID shown to customers
# for manual USDT (TRC20) transfers. API Key + Secret are only needed for the
# real hosted Binance Pay checkout; leave them empty to use manual USDT.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_MERCHANT_ID=
USDT_WALLET_TRC20=

# PayPal (optional - simple mode: just an email or a PayPal.Me link)
# Set via Admin Panel → Settings → Payments. Customers get a "Pay with PayPal"
# button; they paste the Transaction ID afterwards for verification.
PAYPAL_EMAIL=
PAYPAL_LINK=

# TronGrid API key (optional) — raises the rate limit for automatic USDT
# (TRC20) transfer verification. Works without it, but a free key from
# https://www.trongrid.io/ keeps auto-verification smooth under load.
TRONGRID_API_KEY=

# ⭐ Telegram Stars payments — NO extra env needed.
# Works out of the box with your BOT_TOKEN. The admin controls everything from
# Admin Panel → Settings → Payments:
#   stars_enabled  (on/off switch)
#   stars_per_usd  (how many ⭐ equal $1, default 50)

# Webhook - For Railway production
WEBHOOK_DOMAIN=https://your-railway-app.up.railway.app
USE_WEBHOOK=false

# Railway specific
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_ENVIRONMENT=
NODE_ENV=production

# Max accepted age of Telegram WebApp initData, in seconds (replay protection).
# Default: 604800 (7 days). Set to 86400 for strict 24h, 0 to disable.
TG_AUTH_MAX_AGE_SECONDS=604800
