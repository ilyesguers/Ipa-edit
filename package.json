    "express-rate-limit": "^7.2.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.3",
    "winston": "^3.13.0",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
